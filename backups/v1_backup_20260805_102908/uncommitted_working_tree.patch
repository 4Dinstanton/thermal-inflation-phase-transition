+    best = 0
+    best_val = -np.inf
+    for i in range(n):
+        # Prefer late positive growth: use |E_rho| when E_spec>0
+        val = e_rho[i] if e_spec[i] > 0 else -np.inf
+        if val > best_val:
+            best_val = val
+            best = i
+    return best
