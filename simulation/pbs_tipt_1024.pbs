#!/bin/bash
#PBS -N tipt1024-skl
#PBS -V
#PBS -q norm_skl
#PBS -A inhouse
#PBS -l select=4:ncpus=40:mpiprocs=32:ompthreads=1
#PBS -l walltime=24:00:00
#PBS -W sandbox=PRIVATE
#PBS -j oe
#
# TIPT 1024^3, 64 ranks (2 SKL x 32). Submit twice:
#   cd /scratch/a2136a01
#   qsub -v TIPT_POT=fermion_only  PhaseTransition/simulation/pbs_tipt_1024.pbs
#   qsub -v TIPT_POT=V_correct     PhaseTransition/simulation/pbs_tipt_1024.pbs
#
# tMax=1000 does NOT cool the bath to T_rh=100 GeV. H_TI~0.12 GeV so
#   TI:  T = T0 * exp(-H t_phys),  t_phys = tMax/mphi = 1 GeV^{-1}
#        -> only ~12% drop (e.g. 1230 -> ~1090 GeV).
#   MD after conversion: T=100 still needs tMax ~ 5e4 (program time).
# --T_rh 100 is armed; MD->RD will not fire at tMax=1000. Langevin-off and
# TI->MD use false-vac fraction (not mean |phi|; one bubble must not trigger MD).

REPO="${REPO:-/scratch/a2136a01/PhaseTransition}"
NP=128
TIPT_POT="${TIPT_POT:-fermion_only}"

export PYTHONUNBUFFERED=1
unset CC CXX CFLAGS CXXFLAGS

module purge
module load craype-x86-skylake gcc/8.3.0 openmpi/3.1.0
module load hdf5-parallel/1.10.2 fftw_mpi/3.3.7
module load python/3.9.5 2>/dev/null || module load python/3.9 2>/dev/null || true

export CC=mpicc
export CXX=mpicxx
export OMP_NUM_THREADS=1
export OMP_PLACES=cores
export OMP_PROC_BIND=true

cd "$REPO" || exit 1

BIN=external/cosmolattice/build_mpi/thermal_inflation
ls -l "$BIN" || {
  echo "ERROR: $BIN missing. qsub simulation/pbs_build_tipt_skl.pbs first."
  exit 1
}

case "$TIPT_POT" in
  fermion_only)
    T0=1600
    POT_ARGS=(--potential_type fermion_only --nb 0 --nf 20)
    ;;
  V_correct|boson_fermion)
    T0=1230
    TIPT_POT=V_correct
    POT_ARGS=(--potential_type V_correct --nb 20 --nf 20)
    ;;
  *)
    echo "ERROR: TIPT_POT=$TIPT_POT  (fermion_only | V_correct)"
    exit 1
    ;;
esac

echo "host=$(hostname)  date=$(date)"
echo "REPO=$PWD  NP=$NP  TIPT_POT=$TIPT_POT  T0=$T0"
echo "mpirun=$(command -v mpirun)"

# Fields: HDF5 local slabs (field_snapshot.h5), not gathered .raw.
python3 simulation/run_cosmolattice.py \
  --mpi --np "$NP" \
  --Nx 1024 \
  --tMax 1000 \
  --dx_phys 1e-3 --dt_phys 1e-4 \
  --T0 "$T0" \
  "${POT_ARGS[@]}" \
  --eta_follows_T \
  --n_scalars 2 \
  --with_gws \
  --expansion_mode staged \
  --expansion_f_switch 0.01 \
  --expansion_phi_esc 5e4 \
  --T_rh 1000 \
  --langevin_off_after_nucleation \
  --langevin_off_f_switch 0.01 \
  --langevin_off_phi_esc 5e4 \
  --phi_threshold 50000 \
  --steps 4000 \
  --steps_dense 100 \
  --param_set set8

echo "done $(date)"
